@page "/"

<PageTitle>What's For Dinner?</PageTitle>

<section class="home-page">
    <h1>Hvad skal vi spise?</h1>

    <div class="home-content">
        <aside class="frontpage-image-block">
            <img src="images/Frontpage.png" alt="Familie som planlægger ugens mad" />
        </aside>

        <div class="home-sections">
            <MealPlannerSection AllRecipes="RecipeIndices" IsLoading="IsLoading" />
            <RecipeListSection Recipes="RecipeIndices" IsLoading="IsLoading" ErrorMessage="@ErrorMessage" />
        </div>

        <div class="right-gutter-spacer" aria-hidden="true"></div>
    </div>
</section>
