@page "/"

<PageTitle>What's For Dinner?</PageTitle>

<section class="home-page">
    <h1>What's For Dinner?</h1>

    <p>Vælg en opskrift for at komme i gang.</p>

    <div class="search-block">
        <label for="recipe-search">Søg opskrifter</label>
        <input id="recipe-search" type="search" placeholder="Søg opskrifter (kommer senere)" />
    </div>

    @if (IsLoading)
    {
        <p>Indlæser opskrifter...</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="error-message">@ErrorMessage</p>
    }
    else if (!RecipeItems.Any())
    {
        <p>Ingen opskrifter fundet.</p>
    }
    else
    {
        <ul class="recipe-list">
            @foreach (var recipe in RecipeItems)
            {
                <li><a href="/recipe/@recipe.Id">@recipe.Title</a></li>
            }
        </ul>
    }
</section>
