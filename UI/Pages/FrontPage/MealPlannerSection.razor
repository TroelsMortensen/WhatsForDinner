<section class="home-card planner-card">
    <details>
        <summary>Generer en madplan</summary>

        <div class="card-content">
            <div class="planner-controls">
                <label for="planner-count">Antal opskrifter</label>
                <input id="planner-count" type="number" min="1" step="1" @bind="PlannerRecipeCount" />
                <button type="button" @onclick="GenerateWeeklyPlan">Lav madplan</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(WeeklyPlanErrorMessage))
            {
                <p class="error-message">@WeeklyPlanErrorMessage</p>
            }
            else if (WeeklyPlanItems.Any())
            {
                <ul class="weekly-plan-list">
                    @foreach (var recipe in WeeklyPlanItems)
                    {
                        <li><a href="recipe/@recipe.Id">@recipe.Id. @recipe.Title</a></li>
                    }
                </ul>
            }
        </div>
    </details>
</section>
