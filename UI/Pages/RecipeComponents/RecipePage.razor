@page "/recipe/{Id:int}"

<PageTitle>What's For Dinner?</PageTitle>


<div class="recipe-page-shell">
    <NavLink class="home-link" href="/" Match="NavLinkMatch.All">⌂ Home</NavLink>

    @if (IsLoading)
    {
        <p class="recipe-status">Indlæser opskrift...</p>
    }
    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <p class="recipe-status recipe-error">@ErrorMessage</p>
    }
    else if (RecipeData is null)
    {
        <p class="recipe-status">Opskriften blev ikke fundet.</p>
    }
    else
    {
        <article class="recipe-page">
        <header class="recipe-header">
            <h1>@RecipeData.Title</h1>
            <div class="recipe-meta">
                @if (RecipeData.NumberOfPersons is > 0)
                {
                    <span class="servings-control">
                        <span class="recipe-icon">👤</span>
                        <button class="servings-button" type="button" @onclick="DecrementPersons" disabled="@(CurrentPersons() <= 1)">-</button>
                        <span class="servings-value">@CurrentPersons()</span>
                        <button class="servings-button" type="button" @onclick="IncrementPersons">+</button>
                        <span class="servings-label">PERS.</span>
                    </span>
                }
                @if (RecipeData.MinutesOfPreparation is not null)
                {
                    <span><span class="recipe-icon">🥣</span> @FormatMinutes(RecipeData.MinutesOfPreparation.Value)</span>
                }
                @if (RecipeData.TotalMinutes is not null)
                {
                    <span><span class="recipe-icon">🕒</span> @FormatMinutes(RecipeData.TotalMinutes.Value)</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(RecipeData.SubHeader))
            {
                <p class="intro-text">@RecipeData.SubHeader</p>
            }
        </header>

        <div class="container">
            <section class="ingredients">
                <h2>Ingredienser</h2>
                @foreach (var group in RecipeData.RecipeGroups)
                {
                    <h3>@group.Title</h3>
                    <ul class="ingredients-list">
                        @foreach (var ingredient in group.Ingredients)
                        {
                            <li>@FormatIngredient(ingredient)</li>
                        }
                    </ul>
                }
            </section>

            <section class="instructions">
                @RecipeData.Instructions

                @if (!string.IsNullOrWhiteSpace(RecipeData.Note))
                {
                    <div class="note">
                        <span class="note-star">☆</span>@RecipeData.Note
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(RecipeData.ImageUrl))
                {
                    <img class="recipe-image" src="@RecipeData.ImageUrl" alt="@RecipeData.Title" />
                }
            </section>
        </div>
    </article>
    }
</div>
